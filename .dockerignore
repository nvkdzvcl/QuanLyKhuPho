# Version control
.git
.gitignore

# Environment and secrets (never bundle into build context)
**/.env
**/.env.*
**/.env*.local
!**/.env.example
!**/.env.production.example

# Package manager and dependencies
node_modules
**/node_modules
.pnpm-store

# Build outputs and caches
.turbo
**/.turbo
.next
**/.next
dist
**/dist
build
**/build
*.tsbuildinfo
**/*.tsbuildinfo

# Test and report artifacts
coverage
**/coverage
playwright-report*
**/playwright-report*
test-results*
**/test-results*

# Persistent local uploads and temporary files
uploads
**/uploads
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and OS metadata
.idea
.vscode
*.swp
*.swo
.DS_Store
Thumbs.db

# Agent workspaces and internal docs
.agents
.ai-work
