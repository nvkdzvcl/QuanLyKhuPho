# ==============================================================================
# QuanLyKhuPho - Root Environment Variables Example
# ==============================================================================
# Copy this file to .env or create app-specific .env files as needed.
# DO NOT commit real secrets or production credentials to the repository.

# API Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Reverse proxy trust configuration (e.g. loopback, 1, 127.0.0.1, or false; do not use blanket true in production)
TRUST_PROXY=loopback

# Local Infrastructure (matching docker/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/quanlykhupho?schema=public
POSTGRES_PORT=5433
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security & Cryptography Keys
# Leave blank only for local development fallback. Production requires three
# independently generated 32-byte (64 hex character) keys and a 32+ char pepper.
PHONE_ENCRYPTION_KEY=
PHONE_HASH_KEY=
OTP_PEPPER=
SMS_QUEUE_ENCRYPTION_KEY=

# SMS Provider Configuration (Webhook provider is required in production)
SMS_PROVIDER=memory
SMS_PROVIDER_WEBHOOK_URL=https://sms-gateway.example.com/api/send
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_TIMEOUT_MS=5000

# Maximum duration for each read-only infrastructure health probe (100-5000 ms)
HEALTH_PROBE_TIMEOUT_MS=1000

# Officer Bootstrap Command (one-time CLI setup via pnpm --filter @quanlykhupho/api bootstrap:officer)
BOOTSTRAP_OFFICER_PHONE=
BOOTSTRAP_OFFICER_FULL_NAME=

# Attachment storage (outside the public web root)
UPLOAD_DIR=./uploads

# Optional Web Push. Set all three values together; in-app notifications remain active without them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
