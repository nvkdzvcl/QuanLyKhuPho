# ==============================================================================
# QuanLyKhuPho - Root Environment Variables Example
# ==============================================================================
# Copy this file to .env or create app-specific .env files as needed.
# DO NOT commit real secrets or production credentials to the repository.

# API Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Local Infrastructure (matching docker/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quanlykhupho?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security & Cryptography Keys
# Leave blank only for local development fallback. Production requires two
# independently generated 32-byte (64 hex character) keys and a 32+ char pepper.
PHONE_ENCRYPTION_KEY=
PHONE_HASH_KEY=
OTP_PEPPER=

# Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
