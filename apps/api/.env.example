PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quanlykhupho?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security & Encryption Keys (required in production; see root .env.example)
PHONE_ENCRYPTION_KEY=
PHONE_HASH_KEY=
OTP_PEPPER=
SMS_QUEUE_ENCRYPTION_KEY=

# SMS Provider Configuration
SMS_PROVIDER=memory
SMS_PROVIDER_WEBHOOK_URL=https://sms-gateway.example.com/api/send
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_TIMEOUT_MS=5000

# Officer Bootstrap Configuration
BOOTSTRAP_OFFICER_PHONE=
BOOTSTRAP_OFFICER_FULL_NAME=
