{
  "name": "@quanlykhupho/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.js --worker",
    "dev": "prisma generate && nest start --watch",
    "worker": "pnpm run build && node dist/main.js --worker",
    "bootstrap:officer": "pnpm run build && node dist/main.js --bootstrap-officer",
    "deployment:init": "pnpm run build && node dist/main.js --deployment-init",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@prisma/client": "^6.4.1",
    "@quanlykhupho/shared-types": "workspace:*",
    "amqplib": "^0.10.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "express": "^4.21.2",
    "ioredis": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.11",
    "@nestjs/testing": "^11.0.11",
    "@quanlykhupho/eslint-config": "workspace:*",
    "@quanlykhupho/typescript-config": "workspace:*",
    "@types/amqplib": "^0.10.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.21.0",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "typescript": "^5.8.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.7"
  }
}
