datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  resident
  leader
  officer

  @@map("role_enum")
}

enum AccountStatus {
  pending
  active
  locked
  rejected

  @@map("account_status_enum")
}

model Neighborhood {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(255)
  ward        String    @db.VarChar(255)
  district    String    @db.VarChar(255)
  city        String    @db.VarChar(255)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts Account[]

  @@unique([ward, name])
  @@map("neighborhoods")
}

model Account {
  id              String        @id @default(uuid()) @db.Uuid
  phoneEncrypted  String        @map("phone_encrypted") @db.Text
  phoneHash       String        @unique @map("phone_hash") @db.VarChar(64)
  fullName        String        @map("full_name") @db.VarChar(255)
  role            Role          @default(resident)
  status          AccountStatus @default(pending)
  address         String?       @db.VarChar(500)
  rejectionReason String?       @map("rejection_reason") @db.Text
  lockReason      String?       @map("lock_reason") @db.Text
  neighborhoodId  String?       @map("neighborhood_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: Restrict)

  @@index([role, status])
  @@index([neighborhoodId, status])
  @@index([neighborhoodId, role])
  @@map("accounts")
}
