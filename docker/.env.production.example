# ==============================================================================
# QuanLyKhuPho - Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to a secure, non-committed location (e.g. docker/.env.production).
# 2. Replace EVERY placeholder before building images or starting services.
# 3. DO NOT commit production secrets or usable credentials to version control.
# 4. NOTE: NEXT_PUBLIC_API_URL is a BUILD-TIME argument for the Web image.
#    All other variables in this file are RUNTIME-ONLY configurations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host Port Bindings & Network Configuration (Loopback Only)
# ------------------------------------------------------------------------------
# Application ports bind exclusively to 127.0.0.1 for external HTTPS reverse proxy.
# Infrastructure ports (PostgreSQL, Redis, RabbitMQ) are NOT exposed to the host.
API_PORT=4000
WEB_PORT=3000
# Immutable release tag shared by API, Worker, Migration and Web images (for example: 2026.08.27-1).
APP_IMAGE_TAG=

# ------------------------------------------------------------------------------
# 2. Database Infrastructure (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=quanlykhupho_app
# Generate a strong unique database password:
POSTGRES_PASSWORD=
POSTGRES_DB=quanlykhupho

# Internal database connection URL for API and Migration containers:
# Format: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Cache & Session Storage (Redis 7)
# ------------------------------------------------------------------------------
# Internal Redis connection URL:
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 4. Message Broker (RabbitMQ 3.13)
# ------------------------------------------------------------------------------
RABBITMQ_USER=quanlykhupho_broker
# Generate a strong unique RabbitMQ password:
RABBITMQ_PASSWORD=

# Internal RabbitMQ AMQP connection URL for API and SMS Worker containers:
# Format: amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@rabbitmq:5672
RABBITMQ_URL=

# ------------------------------------------------------------------------------
# 5. Core Application & Security Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
# Public HTTPS origin of the Web Frontend (must be HTTPS in production, comma-separated for multiple):
CORS_ORIGIN=https://khupho.example.gov.vn

# The host reverse proxy reaches the container through one Docker bridge hop.
# Use '1' for this documented topology; use an explicit trusted subnet/IP when the topology differs.
# WARNING: Blanket 'true', 'all', or '*' is strictly forbidden in production.
TRUST_PROXY=1

# Health probe timeout in milliseconds (100 - 5000 ms)
HEALTH_PROBE_TIMEOUT_MS=1000

# Persistent attachment upload directory inside the container
UPLOAD_DIR=/app/uploads

# ------------------------------------------------------------------------------
# 6. Cryptography & Encryption Keys (CRITICAL)
# ------------------------------------------------------------------------------
# All keys must be independently generated. NEVER reuse keys across environments.
# Generate 32-byte hex keys: openssl rand -hex 32
# Generate OTP pepper: openssl rand -base64 32
PHONE_ENCRYPTION_KEY=
PHONE_HASH_KEY=
OTP_PEPPER=
SMS_QUEUE_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 7. SMS Provider Configuration
# ------------------------------------------------------------------------------
# 'memory' provider is forbidden in production. Use 'webhook'.
SMS_PROVIDER=webhook
SMS_PROVIDER_WEBHOOK_URL=https://sms-gateway.example.gov.vn/api/v1/send
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 8. Web Push / VAPID Configuration (Optional)
# ------------------------------------------------------------------------------
# If Web Push is used, all three values must be provided together.
# Generate VAPID key pair: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Example only; leave all three values blank when Web Push is not configured.
VAPID_SUBJECT=

# ------------------------------------------------------------------------------
# 9. Web Frontend Build-Time Public URL
# ------------------------------------------------------------------------------
# Publicly accessible HTTPS URL of the backend API, consumed by client browsers.
# IMPORTANT: This value is baked into the Web image at build time (ARG NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_API_URL=https://khupho.example.gov.vn/api
